							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{customerToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/cart/items/1",
							"host": ["{{baseUrl}}"],
							"path": ["cart", "items", "1"]
						}
					}
				},
				{
					"name": "Clear Cart",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{customerToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/cart",
							"host": ["{{baseUrl}}"],
							"path": ["cart"]
						}
					}
				}
			]
		},
		{
			"name": "Orders",
			"item": [
				{
					"name": "My Orders (Customer)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{customerToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/orders",
							"host": ["{{baseUrl}}"],
							"path": ["orders"]
						}
					}
				},
				{
					"name": "Show Order",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{customerToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/orders/1",
							"host": ["{{baseUrl}}"],
							"path": ["orders", "1"]
						}
					}
				},
				{
					"name": "Checkout (Place Order)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{customerToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"shipping_address\": \"123 Example Street, Manila, Philippines\",\n  \"billing_address\": \"Same as shipping\",\n  \"notes\": \"Please call before delivery\",\n  \"payment_method\": \"cod\",\n  \"shipping_cost\": 50\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/orders/checkout",
							"host": ["{{baseUrl}}"],
							"path": ["orders", "checkout"]
						}
					},
					"description": "Creates an order from the current user's cart. Stock is decremented and cart is cleared. payment_method: cod | bank_transfer | credit_card | paypal | stripe"
				},
				{
					"name": "All Orders (Admin)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{adminToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/orders/admin/all?status=&search=",
							"host": ["{{baseUrl}}"],
							"path": ["orders", "admin", "all"],
							"query": [
								{ "key": "status", "value": "" },
								{ "key": "search", "value": "" }
							]
						}
					}
				},
				{
					"name": "Update Order Status (Admin)",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{adminToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"paid\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/orders/1/status",
							"host": ["{{baseUrl}}"],
							"path": ["orders", "1", "status"]
						}
					},
					"description": "status: pending | paid | shipped | completed | cancelled"
				}
			]
		},
