{
	"info": {
		"_postman_id": "6f2f19a1-2f4a-4a9e-8a7f-laravel-ecommerce-api",
		"name": "Laravel E-Commerce API",
		"description": "Complete endpoint collection for the Laravel E-Commerce REST API.\n\nBase URL: http://127.0.0.1:8000/api\n\nLocal credentials:\n- Admin: admin@example.com / password\n- Customer: customer@example.com / password\n\nAuth: pass the token returned by Login/Register as a Bearer token in the Authorization header.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://127.0.0.1:8000/api",
			"type": "string"
		},
		{
			"key": "adminToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "customerToken",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"phone\": \"09171234567\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/register",
							"host": ["{{baseUrl}}"],
							"path": ["register"]
						}
					},
					"description": "Register a new customer account. Returns a Sanctum Bearer token."
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/login",
							"host": ["{{baseUrl}}"],
							"path": ["login"]
						}
					},
					"description": "Login. Copy the returned token into {{adminToken}} or {{customerToken}} and use it as a Bearer token."
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{customerToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/logout",
							"host": ["{{baseUrl}}"],
							"path": ["logout"]
						}
					}
				},
				{
					"name": "Get Current User",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{customerToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/user",
							"host": ["{{baseUrl}}"],
							"path": ["user"]
						}
					}
				}
			]
		},
		{
			"name": "Categories",
			"item": [
				{
					"name": "List Categories",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": {
							"raw": "{{baseUrl}}/categories?per_page=15",
							"host": ["{{baseUrl}}"],
							"path": ["categories"],
							"query": [{ "key": "per_page", "value": "15" }]
						}
					}
				},
				{
					"name": "Show Category",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": {
							"raw": "{{baseUrl}}/categories/1",
							"host": ["{{baseUrl}}"],
							"path": ["categories", "1"]
						}
					}
				},
				{
					"name": "Create Category (Admin)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{adminToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"New Category\",\n  \"description\": \"Description here\",\n  \"parent_id\": null,\n  \"is_active\": true,\n  \"sort_order\": 10\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/categories",
							"host": ["{{baseUrl}}"],
							"path": ["categories"]
						}
					}
				},
				{
					"name": "Update Category (Admin)",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{adminToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Updated Category Name\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/categories/1",
							"host": ["{{baseUrl}}"],
							"path": ["categories", "1"]
						}
					}
				},
				{
					"name": "Delete Category (Admin)",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{adminToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/categories/1",
							"host": ["{{baseUrl}}"],
							"path": ["categories", "1"]
						}
					}
				}
			]
		},
		{
			"name": "Products",
			"item": [
				{
					"name": "List Products",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": {
							"raw": "{{baseUrl}}/products?search=&category_id=&min_price=&max_price=&status=active&featured=false&sort_by=created_at&sort_direction=desc&per_page=15",
							"host": ["{{baseUrl}}"],
							"path": ["products"],
							"query": [
								{ "key": "search", "value": "" },
								{ "key": "category_id", "value": "" },
								{ "key": "min_price", "value": "" },
								{ "key": "max_price", "value": "" },
								{ "key": "status", "value": "active" },
								{ "key": "featured", "value": "false" },
								{ "key": "sort_by", "value": "created_at" },
								{ "key": "sort_direction", "value": "desc" },
								{ "key": "per_page", "value": "15" }
							]
						}
					},
					"description": "Public product listing with pagination, search, filters, sorting."
				},
				{
					"name": "Show Product",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": {
							"raw": "{{baseUrl}}/products/1",
							"host": ["{{baseUrl}}"],
							"path": ["products", "1"]
						}
					}
				},
				{
					"name": "List Product Reviews",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": {
							"raw": "{{baseUrl}}/products/1/reviews",
							"host": ["{{baseUrl}}"],
							"path": ["products", "1", "reviews"]
						}
					}
				},
				{
					"name": "Create Product (Admin)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{adminToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Wireless Headphones\",\n  \"description\": \"Premium noise-cancelling headphones\",\n  \"price\": 2499.00,\n  \"compare_price\": 2999.00,\n  \"stock\": 40,\n  \"category_id\": 1,\n  \"images\": [\"https://example.com/img1.jpg\", \"https://example.com/img2.jpg\"],\n  \"status\": \"active\",\n  \"is_featured\": true,\n  \"weight\": 0.35\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/products",
							"host": ["{{baseUrl}}"],
							"path": ["products"]
						}
					}
				},
				{
					"name": "Update Product (Admin)",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{adminToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"price\": 2299.00,\n  \"stock\": 35\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/products/1",
							"host": ["{{baseUrl}}"],
							"path": ["products", "1"]
						}
					}
				},
				{
					"name": "Delete Product (Admin)",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{adminToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/products/1",
							"host": ["{{baseUrl}}"],
							"path": ["products", "1"]
						}
					}
				}
			]
		},
		{
			"name": "Cart",
			"item": [
				{
					"name": "Get Cart",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{customerToken}}" }
