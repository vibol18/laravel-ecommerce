							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{customerToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"product_id\": 1,\n  \"quantity\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/cart/add",
							"host": ["{{baseUrl}}"],
							"path": ["cart", "add"]
						}
					}
				},
