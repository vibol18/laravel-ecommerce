						"body": {
							"mode": "raw",
							"raw": "{\n  \"quantity\": 3\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/cart/items/1",
							"host": ["{{baseUrl}}"],
							"path": ["cart", "items", "1"]
